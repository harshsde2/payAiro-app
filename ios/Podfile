# Force enable New Architecture for Reanimated 4.x compatibility
ENV['RCT_NEW_ARCH_ENABLED'] = '1'

# Resolve react_native_pods.rb with node to allow for hoisting
# require Pod::Executable.execute_command('node', ['-p',
#   'require.resolve(
#     "react-native/scripts/react_native_pods.rb",
#     {paths: [process.argv[1]]},
#   )', __dir__]).strip
def node_require(script)
  # Resolve script with node to allow for hoisting
  require Pod::Executable.execute_command('node', ['-p',
    "require.resolve(
      '#{script}',
      {paths: [process.argv[1]]},
    )", __dir__]).strip
end

# Use it to require both react-native's and this package's scripts:
node_require('react-native/scripts/react_native_pods.rb')
node_require('react-native-permissions/scripts/setup.rb')
platform :ios, min_ios_version_supported
prepare_react_native_project!

# Firebase requires static frameworks (incompatible with Flipper)
use_frameworks! :linkage => :static
$RNFirebaseAsStaticFramework = true

setup_permissions([
 # 'AppTrackingTransparency',
 # 'Bluetooth',
 # 'Calendars',
 # 'CalendarsWriteOnly',
 'Camera',
 # 'Contacts',
 'FaceID',
 # 'LocationAccuracy',
 'LocationAlways',
 'LocationWhenInUse',
 'MediaLibrary',
 # 'Microphone',
 # 'Motion',
 # 'Notifications',
 'PhotoLibrary',
 'PhotoLibraryAddOnly',
 # 'Reminders',
 # 'Siri',
 # 'SpeechRecognition',
 # 'StoreKit',
])
linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
 Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
 use_frameworks! :linkage => linkage.to_sym
end

target 'payAiro' do
 config = use_native_modules!

 # Add Plaid SDK
 pod 'Plaid', '~> 6.4.0'

 use_react_native!(
   :path => config[:reactNativePath],
   # An absolute path to your application root.
   :app_path => "#{Pod::Config.instance.installation_root}/.."
 )

 target 'payAiroTests' do
   inherit! :complete
   # Pods for testing
 end

  # React Native Config - Environment file configuration
  # 
  # The .env file is copied by:
  # 1. npm scripts (before react-native run-ios) - copies .env.staging or .env.production to .env
  # 2. Xcode pre-build scripts (in schemes) - copies correct .env file before build
  #
  # react-native-config will use the .env file in the project root
  # For Xcode Archive builds, ENVFILES mapping ensures correct .env file at native build time
  ENVFILES = {
    'Debug' => '$(PODS_ROOT)/../../.env',
    'Release' => '$(PODS_ROOT)/../../.env',
    'StagingRelease' => '$(PODS_ROOT)/../../.env',
  }

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
    
    # Configure react-native-config to use the .env file
    # The .env file is copied by pre-build scripts or npm scripts before the build
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        if target.name == 'react-native-config'
          env_file = ENVFILES[config.name]
          if env_file
            config.build_settings['ENVFILE'] = env_file
            Pod::UI.puts "  ✓ react-native-config: #{config.name} → #{env_file}".green
          end
        end
      end
    end
  end
end