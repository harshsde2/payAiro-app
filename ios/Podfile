# Firebase requires static frameworks (incompatible with Flipper)
use_frameworks! :linkage => :static
$RNFirebaseAsStaticFramework = true

setup_permissions([
 # 'AppTrackingTransparency',
 # 'Bluetooth',
 # 'Calendars',
 # 'CalendarsWriteOnly',
 'Camera',
 # 'Contacts',
 'FaceID',
 # 'LocationAccuracy',
 'LocationAlways',
 'LocationWhenInUse',
 'MediaLibrary',
 # 'Microphone',
 # 'Motion',
 # 'Notifications',
 'PhotoLibrary',
 'PhotoLibraryAddOnly',
 # 'Reminders',
 # 'Siri',
 # 'SpeechRecognition',
 # 'StoreKit',
])
linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
 Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
 use_frameworks! :linkage => linkage.to_sym
end

target 'payAiro' do
 # Google Maps on iOS: declare before use_native_modules! so autolinking skips the default Maps-only pod
 # but codegen still registers Fabric views (RNMapsGoogleMapView, etc.) in RCTThirdPartyComponentsProvider.
 pod 'react-native-maps/Google', :path => '../node_modules/react-native-maps'

 config = use_native_modules!

 # Add Plaid SDK
 pod 'Plaid', '~> 6.4.0'

 # Add Coinme Risk SDK (fetched from packages.coinme.com via the `source`
 # line declared at the top of this Podfile). Requires iOS 16.0+.
 pod 'CoinmeRiskSDK', '~> 1.1.1'

  use_react_native!(
    :path => config[:reactNativePath],
    # Absolute app root so codegen embeds stable relative paths (see ReactCodegen script phase).
    :app_path => File.expand_path('..', __dir__)
  )

 target 'payAiroTests' do
   inherit! :complete
   # Pods for testing
 end

  # React Native Config - Environment file configuration
  # 
  # The .env file is copied by:
  # 1. npm scripts (before react-native run-ios) - copies .env.staging or .env.production to .env
  # 2. Xcode pre-build scripts (in schemes) - copies correct .env file before build
  #
  # react-native-config will use the .env file in the project root
  # For Xcode Archive builds, ENVFILES mapping ensures correct .env file at native build time
  ENVFILES = {
    'Debug' => '$(PODS_ROOT)/../../.env',
    'Release' => '$(PODS_ROOT)/../../.env',
    'StagingRelease' => '$(PODS_ROOT)/../../.env',
  }

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
    
    # Fix "non-modular-include-in-framework-module" build errors (React-Core and other pods)
    # Also enforce iOS 16.0 deployment target on every pod so no transitive
    # dependency silently downgrades below CoinmeRiskSDK's minimum.
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'
      end
    end
    
    # Configure react-native-config to use the .env file
    # The .env file is copied by pre-build scripts or npm scripts before the build
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        if target.name == 'react-native-config'
          env_file = ENVFILES[config.name]
          if env_file
            config.build_settings['ENVFILE'] = env_file
            Pod::UI.puts "  ✓ react-native-config: #{config.name} → #{env_file}".green
          end
        end
      end
    end
  end
end