# ========================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# ========================================
API_BASE_URL=https://your-api-url.com/api/
USER_API_BASE_URL=https://pa-fastapi.payairo.com
API_TIMEOUT=30000
ENV_NAME=development
ENV_TYPE=development
ENABLE_LOGGING=true
ENABLE_ERROR_TRACKING=false
ENABLE_ANALYTICS=false
PRIVACY_POLICY_URL=https://payairo.com/privacy-policy.html
TERMS_AND_CONDITIONS_URL=https://www.payairo.com/terms-of-Use.html
APP_NAME=PayAiro
APP_DISPLAY_NAME=PayAiro
API_RETRY_COUNT=3
API_RETRY_DELAY=1000
SHOW_ENV_BANNER=false
ALLOW_DEV_TOOLS=false

# Google Maps SDK (react-native-maps). Enable Maps SDK for iOS / Android on each key in Google Cloud.
# iOS: AppDelegate uses GOOGLE_MAPS_API_KEY_IOS, then falls back to GOOGLE_MAPS_API_KEY.
GOOGLE_MAPS_API_KEY_IOS=your_ios_maps_key
# Android: build.gradle manifest placeholder uses GOOGLE_MAPS_API_KEY_ANDROID, then GOOGLE_MAPS_API_KEY.
GOOGLE_MAPS_API_KEY_ANDROID=your_android_maps_key
# Optional single key if both platforms share one credential:
# GOOGLE_MAPS_API_KEY=


# Optional: Wert RN web checkout bridge settings (non-secret)
# WERT_CHECKOUT_PAGE_BASE_URL=https://your-domain.com/wert/checkout
# WERT_PARTNER_ID=your_partner_id
# WERT_WIDGET_ORIGIN=https://sandbox.wert.io
