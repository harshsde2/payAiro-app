# Coinme Vault SDK (@coinme-security/*) — private registry.
# Token is read from coinme.properties (COINME_TOKEN) via scripts/npm-with-coinme.sh,
# or export COINME_TOKEN yourself before running npm install.
@coinme-security:registry=https://npm.coinme.com/coinme-security-wrapper/
//npm.coinme.com/coinme-security-wrapper/:_authToken=${COINME_TOKEN}
always-auth=true
